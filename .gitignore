.env
src/.env.example
__pycache__/
.venv/
.cache/
*.pyc
usage*.jsonl
# Cost data written by the containers (docker/compose.yml). Real usage against
# a personal key, with timestamps; the report carries the summary, not this.
/usage/

# Saved web pages at the root only. The leading slash matters: without it this
# would also exclude application/index.html, which is part of the console.
/*.html
orchestrator_trace.jsonl
wandb/

# Pinned data (src/pin_snapshot.py). The manifest is tracked, so every checkout
# records which snapshot the ground truth was measured on; the ~125 MB of data
# it describes is not.
/snapshot/*
!/snapshot/MANIFEST.json
