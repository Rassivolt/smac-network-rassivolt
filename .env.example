# Copy to .env at the repository root and fill in. Never commit .env.
# Without a working ANTHROPIC_API_KEY nothing starts: the agent, the console,
# ask.py and the evaluation all check it first.
ANTHROPIC_API_KEY=
# Required by src/eval/run_eval.py, which logs every run to Weights & Biases.
WANDB_API_KEY=
WANDB_PROJECT=Network_Agent
WANDB_ENTITY=
# Optional: claude-haiku-4-5 (default), claude-sonnet-5 or claude-opus-5.
LLM_MODEL=
# Optional, outside Docker: where the agent listens. Defaults 127.0.0.1 and 8000;
# compose.yml sets HOST=0.0.0.0 itself. Set HOST=0.0.0.0 to serve a local network.
HOST=
PORT=
