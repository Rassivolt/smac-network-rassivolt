# Docker reads this from the build context, which is the repository root.
#
# Docker patterns do not cross a slash, so `*.md` and `*.html` exclude the
# noisy files at the root only. application/index.html and src/README.md are
# inside COPY'd directories and stay in the image.
.git
docs
logs
usage
*.md
*.html
**/__pycache__
**/.cache
**/.env
**/usage.jsonl
# Mounted into the network container at run time, never copied into the image.
snapshot
